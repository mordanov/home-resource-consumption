# ── Database ──────────────────────────────────────────────────────────────────
# Full async SQLAlchemy DSN used by the backend container.
# When running via Docker Compose, host must be "db" (the service name).
DATABASE_URL=postgresql+asyncpg://resource_user:resource_pass@db:5432/resource_tracker

# Raw Postgres credentials (used by the db service and health check).
POSTGRES_USER=resource_user
POSTGRES_PASSWORD=resource_pass
POSTGRES_DB=resource_tracker

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Secret key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...replace-with-real-key...
# Model to use for bill parsing. gpt-4o or gpt-4o-mini recommended.
OPENAI_MODEL=gpt-4o-mini

# ── File uploads ──────────────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10
# Path inside the container where uploaded files are stored.
UPLOAD_DIR=/app/uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Add your frontend URL in production.
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:80"]

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure secret with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 256 bits (64 hex characters). NEVER commit a real value.
JWT_SECRET_KEY=replace-this-with-a-64-char-hex-string-generated-by-secrets-token-hex-32
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (short-lived).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7
